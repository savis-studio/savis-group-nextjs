# Copy to .env. Local development only needs the first four lines.

# Long random string (openssl rand -hex 32). Required in production.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# SQLite for local work. On the VPS docker-compose builds the Postgres URL itself from POSTGRES_PASSWORD.
DATABASE_URL=file:./data/payload.db
# Public site URL. Used for CSRF and CORS allow-lists.
SERVER_URL=http://localhost:3000
# Extra trusted origins, comma-separated (optional)
ALLOWED_ORIGINS=

# ---- Production on the VPS (~/savis/.env) ----
# Letters and digits only (openssl rand -hex 24): it is placed inside a URL.
# POSTGRES_PASSWORD=
# Only this host may be indexed by search engines. Every other host (the staging hostname) gets noindex.
# INDEXABLE_HOST=savis-group.com
# Cloudflare Access application that protects /admin and /api (Zero Trust > Access > Applications).
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<AUD tag>
# Optional: AUD tag of a second Access application for <host>/api/mcp, reached with a service token (see DEPLOY.md).
# CF_ACCESS_MCP_AUD=
# Production refuses /admin and /api when these two are missing. CF_ACCESS_ENFORCE=off disables the check on purpose.
# CF_ACCESS_ENFORCE=off
# Cloudflare Tunnel token and a pinned cloudflared tag (see https://github.com/cloudflare/cloudflared/releases).
# TUNNEL_TOKEN=
# CLOUDFLARED_TAG=
# Written by deploy.sh. Do not edit by hand.
# SAVIS_IMAGE_TAG=

# HubSpot: contact-form messages are copied to this HubSpot form (Forms API). Leave empty to keep them in Payload only.
# HUBSPOT_PORTAL_ID=
# HUBSPOT_FORM_ID=
# HubSpot form "Resource request": requests for a report or whitepaper are copied to it. Empty: kept in Payload only.
# HUBSPOT_RESOURCE_FORM_ID=
