# Copy to .env
# Long random string (openssl rand -hex 32). Required in production.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# SQLite for local work; use postgres://user:pass@host:5432/db?sslmode=require in production
DATABASE_URL=file:./data/payload.db
# Public site URL. Used for CSRF and CORS allow-lists.
SERVER_URL=http://localhost:3000
# Extra trusted origins, comma-separated (optional)
ALLOWED_ORIGINS=
